generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      String   @default("editor") // admin, editor, viewer
  allSites  Boolean  @default(false) // 編輯者不設限：可管理所有子網站
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sites     SiteUser[]
  featureViews FeatureView[]
  logins    LoginRecord[]
}

model Site {
  id           Int           @id @default(autoincrement())
  name         String
  slug         String        @unique
  description  String?
  status       String        @default("active")
  primaryColor String        @default("#2563eb")
  accentColor  String        @default("#1d4ed8")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        SiteUser[]
  pages        Page[]
  posts        Post[]
  media        Media[]
  siteFeatures SiteFeature[]
  featureEntries FeatureEntry[]
  home         SiteHome?
  announcements Announcement[]
  progressItems ProgressItem[]
  exhibitions Exhibition[]
  meetings     MeetingRecord[]
  vendors      Vendor[]
  selection    SelectionInfo?
  maps         MapAsset[]
  attachments  ContentAttachment[]
  homeSections SiteHomeSection[]
  featureViews FeatureView[]
}

model FeatureDefinition {
  id           Int           @id @default(autoincrement())
  key          String        @unique
  label        String
  icon         String?
  path         String
  description  String?
  isSystem     Boolean       @default(false)
  displayMode  String        @default("list")
  createdAt    DateTime      @default(now())
  siteFeatures SiteFeature[]
  entries      FeatureEntry[]
  homeSections SiteHomeSection[]
}

model SiteFeature {
  id          Int               @id @default(autoincrement())
  siteId      Int
  featureId   Int
  enabled     Boolean           @default(true)
  sortOrder   Int               @default(0)
  displayMode String            @default("list")
  visibility  String            @default("public")
  site        Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  feature     FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([siteId, featureId])
}

model FeatureEntry {
  id          Int               @id @default(autoincrement())
  siteId      Int
  featureId   Int
  title       String
  content     String?
  contentType String            @default("text")
  youtubeUrl  String?
  mediaId     Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  site        Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  feature     FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)
  media       Media?            @relation("FeatureEntryMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([siteId, featureId])
  @@index([mediaId])
}

model SiteUser {
  id        Int      @id @default(autoincrement())
  userId    Int
  siteId    Int
  role      String   @default("editor") // admin, editor, viewer
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  site      Site     @relation(fields: [siteId], references: [id])

  @@unique([userId, siteId])
}

model Page {
  id        Int      @id @default(autoincrement())
  siteId    Int
  title     String
  slug      String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id])

  @@unique([siteId, slug])
}

model Post {
  id        Int      @id @default(autoincrement())
  siteId    Int
  title     String
  slug      String
  content   String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id])

  @@unique([siteId, slug])
}

model Media {
  id        Int      @id @default(autoincrement())
  siteId    Int
  filename  String
  url       String
  type      String
  mimeType  String?
  sizeBytes Int?
  altText   String?
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id])
  attachments ContentAttachment[]
  homeHero   SiteHome[] @relation("SiteHomeHeroMedia")
  vendorLogos Vendor[] @relation("VendorLogoMedia")
  mapImages MapAsset[] @relation("MapImageMedia")
  mapDownloads MapAsset[] @relation("MapDownloadMedia")
  featureEntryImages FeatureEntry[] @relation("FeatureEntryMedia")
}

model SiteHomeSection {
  id         Int       @id @default(autoincrement())
  siteId     Int
  sourceType String // feature, announcement, progress, page
  featureId  Int? // 僅 sourceType = feature 時使用
  filter     String    @default("all") // 僅 progress：current, all
  title      String?
  limit      Int       @default(3)
  showAll    Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  site       Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  feature    FeatureDefinition? @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@index([siteId, sortOrder])
}

model SiteHome {
  id             Int      @id @default(autoincrement())
  siteId         Int      @unique
  tagline        String?
  intro          String?
  heroMediaId    Int?
  currentStage   String?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  contactAddress String?
  updatedAt      DateTime @updatedAt
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  heroMedia      Media?   @relation("SiteHomeHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
}

model Announcement {
  id          Int      @id @default(autoincrement())
  siteId      Int
  title       String
  slug        String
  summary     String?
  content     String?
  category    String?
  pinned      Boolean  @default(false)
  status      String   @default("draft")
  publishedAt DateTime?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([siteId])
}

model ProgressItem {
  id             Int      @id @default(autoincrement())
  siteId         Int
  stageDate      DateTime
  stageLabel     String
  title          String
  summary        String?
  content        String?
  progressStatus String
  status         String   @default("draft")
  sortOrder      Int      @default(0)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Exhibition {
  id              Int      @id @default(autoincrement())
  siteId          Int
  title           String
  slug            String
  startDate       DateTime?
  endDate         DateTime?
  location        String?
  description     String?
  feedbackSummary String?
  status          String   @default("draft")
  sortOrder       Int      @default(0)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([siteId])
}

model MeetingRecord {
  id          Int      @id @default(autoincrement())
  siteId      Int
  meetingType String
  meetingNo   String?
  title       String
  meetingDate DateTime
  summary     String?
  status      String   @default("draft")
  sortOrder   Int      @default(0)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Vendor {
  id           Int      @id @default(autoincrement())
  siteId       Int
  name         String
  category     String
  summary      String?
  description  String?
  services     String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  logoMediaId  Int?
  status       String   @default("draft")
  sortOrder    Int      @default(0)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  logoMedia    Media?   @relation("VendorLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)

  @@index([siteId])
}

model SelectionInfo {
  id             Int      @id @default(autoincrement())
  siteId         Int      @unique
  title          String
  description    String?
  applicableStage String?
  rules          String?
  notice         String?
  deadline       DateTime?
  externalUrl    String?
  status         String   @default("draft")
  publishedAt    DateTime?
  updatedAt      DateTime @updatedAt
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model MapAsset {
  id             Int      @id @default(autoincrement())
  siteId         Int
  title          String
  category       String?
  description    String?
  imageMediaId   Int?
  downloadMediaId Int?
  status         String   @default("draft")
  sortOrder      Int      @default(0)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  imageMedia     Media?   @relation("MapImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  downloadMedia  Media?   @relation("MapDownloadMedia", fields: [downloadMediaId], references: [id], onDelete: SetNull)

  @@index([siteId])
}

model ContentAttachment {
  id        Int      @id @default(autoincrement())
  siteId    Int
  mediaId   Int
  ownerType String
  ownerId   Int
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([ownerType, ownerId])
}

// 前台功能頁瀏覽記錄：feature 存 FeatureDefinition.key（冗餘），userId 為 null 代表未登入訪客
model FeatureView {
  id        Int      @id @default(autoincrement())
  siteId    Int
  feature   String
  path      String
  userId    Int?
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([siteId, feature, createdAt])
  @@index([siteId, userId, createdAt])
}

// 使用者登入紀錄（NextAuth events.signIn 寫入）
model LoginRecord {
  id        Int      @id @default(autoincrement())
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}
